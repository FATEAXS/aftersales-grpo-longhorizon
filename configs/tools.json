{
  "tools": [
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "query_user_orders",
          "description": "查询当前用户名下全部订单的摘要（订单号、商品、金额、状态、签收日期）。当用户没有提供订单号、或提供的订单号与所述商品对不上时，先用它定位正确订单。",
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "query_order",
          "description": "查询订单详情：条目、规格、实付金额、支付/发货/签收时间与状态。",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "订单号，必须来自工具返回的 observation，不得凭记忆或猜测构造。"
              }
            },
            "required": [
              "order_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "query_logistics",
          "description": "查询订单物流轨迹与当前状态（是否签收、是否滞留）。",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "订单号，必须来自工具返回的 observation，不得凭记忆或猜测构造。"
              }
            },
            "required": [
              "order_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "query_user_profile",
          "description": "查询当前用户档案：会员等级、90 天退款次数、90 天投诉次数。退款次数达到 6 次属于风控信号，此类无理由退款诉求必须转人工。",
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "query_policy",
          "description": "查询指定商品类目的售后政策：无理由退货窗口、质量问题退货/换货窗口、尺码换货窗口、价保窗口、仅退款规则、补偿券上限。执行任何售后动作前必须先查询对应类目政策。",
          "parameters": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "description": "商品类目，如 3C数码、服装鞋帽。"
              }
            },
            "required": [
              "category"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "apply_refund",
          "description": "发起退款（不退货）。refund_type=full 为全额退款；refund_type=partial 用于价保差价等部分退款，需给 amount。虚拟商品不支持。",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "订单号，必须来自工具返回的 observation，不得凭记忆或猜测构造。"
              },
              "refund_type": {
                "type": "string",
                "enum": [
                  "full",
                  "partial"
                ]
              },
              "amount": {
                "type": "number",
                "description": "partial 退款金额（元）。"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "order_id",
              "refund_type",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "apply_return",
          "description": "发起退货退款。需先确认订单在政策允许的退货窗口内且理由成立。",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "订单号，必须来自工具返回的 observation，不得凭记忆或猜测构造。"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "order_id",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "apply_exchange",
          "description": "发起换货，需指定 new_option（必须取自该商品的可选规格）。定制商品与虚拟商品不支持。",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "订单号，必须来自工具返回的 observation，不得凭记忆或猜测构造。"
              },
              "new_option": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "order_id",
              "new_option",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "issue_compensation",
          "description": "发放补偿券。金额不得超过当前用户的政策上限（query_policy 返回中会给出）。",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "订单号，必须来自工具返回的 observation，不得凭记忆或猜测构造。"
              },
              "amount": {
                "type": "number"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "order_id",
              "amount",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "escalate_to_human",
          "description": "转接人工客服并结束会话。仅用于：用户 90 天退款次数 >= 6 的风控诉求、政策未覆盖的争议。可正常解决的诉求转人工会被判为过早升级。",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "订单号，必须来自工具返回的 observation，不得凭记忆或猜测构造。"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "order_id",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "reply_user",
          "description": "向用户发送一条说明（政策解释、处理结果、安抚）。每次决策后都应告知用户；拒绝售后时必须先解释对应政策条款。",
          "parameters": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "maxLength": 1500
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "aftersales_grpo.training.grpo.adapter.tools.AftersaleTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "finish",
          "description": "结束会话并申报最终解决方式，resolution 必须与实际执行过的动作一致。summary 用一句话说明处理结果。",
          "parameters": {
            "type": "object",
            "properties": {
              "resolution": {
                "type": "string",
                "enum": [
                  "refund_only_full",
                  "return_refund",
                  "exchange",
                  "refund_partial",
                  "compensation_only",
                  "rejected",
                  "escalated",
                  "unresolved"
                ]
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "resolution",
              "summary"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}